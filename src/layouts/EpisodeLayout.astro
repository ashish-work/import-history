---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageShell from './PageShell.astro';
import episodes from '../data/episodes.json';

interface Props {
  number: number;
  title: string;
  era: string;
  accent: string;
  status: 'full' | 'stub';
  intro?: string;
  image?: ImageMetadata;
}
const { number, title, era, accent, status, intro, image } = Astro.props;
const num = String(number).padStart(2, '0');
const next = episodes.find((e) => e.number === number + 1);
---
<PageShell title={`E${num} — ${title} · import history`}>
  <article class="episode" style={`--accent: var(--${accent})`}>
    <header class="ep-header">
      <p class="ep-num">EPISODE {num}</p>
      <h1>{title}</h1>
      <p class="ep-era">{era}</p>
      {intro && <p class="ep-intro">{intro}</p>}
      {image && (
        <Image
          src={image}
          alt={`Episode ${num} artwork — ${title}`}
          widths={[390, 780, 1400]}
          sizes="(max-width: 780px) 100vw, 780px"
          class="ep-poster pixel-border"
        />
      )}
    </header>

    <div class="ep-body">
      <slot />
    </div>

    <footer class="ep-next">
      {next ? (
        <a href={`/episodes/${next.slug}/`} class="next-link pixel-border">
          <span class="next-label">NEXT EPISODE →</span>
          <span class="next-title">E{String(next.number).padStart(2, '0')} · {next.title}</span>
          {next.status === 'stub' && <span class="next-status">[ IN PRODUCTION ]</span>}
        </a>
      ) : (
        <a href="/" class="next-link pixel-border">
          <span class="next-label">ROLL CREDITS →</span>
          <span class="next-title">Back to the timeline</span>
        </a>
      )}
    </footer>
  </article>
</PageShell>

<style>
  .episode {
    padding: calc(var(--grid) * 4) 0;
  }
  .ep-num {
    font-family: var(--font-display);
    font-size: 12px;
    color: var(--accent);
    margin: 0 0 calc(var(--grid) * 2);
  }
  h1 {
    font-size: 20px;
    color: var(--accent);
    margin: 0 0 calc(var(--grid) * 2);
  }
  .ep-era {
    font-family: var(--font-terminal);
    font-size: 20px;
    color: var(--dim);
    margin: 0 0 calc(var(--grid) * 4);
  }
  .ep-intro {
    font-size: 17px;
    color: var(--dim);
    border-left: 4px solid var(--accent);
    padding-left: calc(var(--grid) * 2);
    margin: 0 0 calc(var(--grid) * 4);
  }
  .ep-poster {
    display: block;
    width: 100%;
    height: auto;
    border-color: var(--accent);
    box-shadow: 6px 6px 0 var(--accent);
    margin: 0 0 calc(var(--grid) * 4);
  }
  /* prose defaults for MDX content (Tailwind preflight zeroes these) */
  .ep-body :global(h2) {
    font-size: 14px;
    color: var(--accent);
    margin: calc(var(--grid) * 6) 0 calc(var(--grid) * 3);
  }
  .ep-body :global(p) {
    margin: 0 0 calc(var(--grid) * 3);
  }
  .ep-body :global(ul) {
    margin: 0 0 calc(var(--grid) * 3);
    padding-left: calc(var(--grid) * 3);
    list-style: square;
  }
  .ep-body :global(li) {
    margin-bottom: var(--grid);
  }
  .ep-body :global(code) {
    color: var(--py-yellow);
    font-size: 15px;
  }
  .ep-body :global(a) {
    color: var(--py-blue);
  }
  .ep-next {
    margin-top: calc(var(--grid) * 8);
  }
  .next-link {
    display: flex;
    flex-direction: column;
    gap: var(--grid);
    padding: calc(var(--grid) * 2);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
  }
  .next-link:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .next-link:hover .next-label,
  .next-link:hover .next-status {
    color: var(--bg);
  }
  .next-label {
    font-family: var(--font-display);
    font-size: 12px;
    color: var(--accent);
  }
  .next-title {
    font-family: var(--font-terminal);
    font-size: 22px;
  }
  .next-status {
    font-family: var(--font-terminal);
    font-size: 20px;
    color: var(--amber);
  }
</style>
