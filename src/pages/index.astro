---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageShell from '../layouts/PageShell.astro';
import DualTimeline from '../components/DualTimeline.astro';
import episodes from '../data/episodes.json';

const posters = import.meta.glob<{ default: ImageMetadata }>('../content/episodes/*.png', {
  eager: true,
});
const posterFor = (slug: string) => posters[`../content/episodes/${slug}.png`]?.default;
---
<PageShell>
  <section class="hero">
    <p class="stamp">[ SIGNAL ACQUIRED <span class="cursor"></span> ]</p>
    <h1>import history</h1>
    <p class="subtitle">An 8-bit documentary about Python's evolution — the fights, the people, and the industry pressure behind every feature.</p>
  </section>

  <section class="thesis pixel-border">
    <p>
      <strong>Language features are lagging indicators of industry pressure.</strong>
      Python never added anything because it was elegant — every feature is a delayed
      response to something happening outside the language.
    </p>
  </section>

  <section class="about">
    <p>
      This is an eight-episode documentary about how Python became what it is.
      Not a syntax tutorial — the fights, the people, and the industry pressure
      behind every feature. Why indentation is syntax, why the GIL existed for
      thirty-four years, why your code looks the way it does. Start at episode
      1, or jump in at the era that left scars on you.
    </p>
  </section>

  <section aria-label="Dual timeline: the industry vs Python releases">
    <h2>THE PRESSURE LINE</h2>
    <p class="section-intro">
      Two columns, one clock. The left column is what the industry did; the
      right is what Python shipped. Read them together and the thesis appears:
      the language answers years after the world asks. The colored bands mark
      each episode's era — follow one into its story.
    </p>
    <DualTimeline />
  </section>

  <section aria-label="Episodes">
    <h2>EPISODES</h2>
    <p class="section-intro">
      Eight eras, one argument. Every episode follows the same arc: what the
      world was doing, the pressure it put on Python, what the language shipped
      in response, and the fight it took to get there.
    </p>
    <ol class="ep-grid">
      {episodes.map((e) => (
        <li>
          <a href={`/episodes/${e.slug}/`} class="ep-card pixel-border" style={`--accent: var(--${e.accent})`}>
            {posterFor(e.slug) && (
              <Image
                src={posterFor(e.slug)!}
                alt=""
                widths={[390, 780]}
                sizes="(max-width: 768px) 100vw, 390px"
                class="ep-thumb"
              />
            )}
            <span class="ep-num">E{String(e.number).padStart(2, '0')}</span>
            <span class="ep-title">{e.title}</span>
            <span class="ep-years">{e.subtitle ? `${e.subtitle} · ` : ''}{e.years}</span>
            <span class="ep-teaser">{e.teaser}</span>
            <span class={`ep-status ${e.status}`}>
              {e.status === 'full' ? '▶ WATCH' : '[ IN PRODUCTION ]'}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <p class="methodology">
    Written from the primary sources: python-dev, PEPs, and the people who were there.
  </p>

  <style>
    .hero {
      padding: calc(var(--grid) * 8) 0 calc(var(--grid) * 4);
    }
    .stamp {
      font-family: var(--font-terminal);
      font-size: 20px;
      color: var(--amber);
      margin: 0 0 calc(var(--grid) * 2);
    }
    h1 {
      font-size: 24px;
      color: var(--phosphor);
      margin: 0 0 calc(var(--grid) * 2);
    }
    .subtitle {
      color: var(--dim);
      margin: 0;
    }
    h2 {
      font-size: 14px;
      color: var(--ink);
      margin: calc(var(--grid) * 8) 0 calc(var(--grid) * 3);
    }
    .thesis {
      background: var(--surface);
      padding: calc(var(--grid) * 3);
      margin: calc(var(--grid) * 4) 0 calc(var(--grid) * 6);
    }
    .thesis p { margin: 0; }
    .thesis strong { color: var(--py-yellow); }

    .about p {
      margin: 0 0 calc(var(--grid) * 2);
      color: var(--ink);
    }
    .section-intro {
      color: var(--dim);
      margin: 0 0 calc(var(--grid) * 3);
    }

    .ep-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: calc(var(--grid) * 3);
    }
    @media (min-width: 768px) {
      .ep-grid { grid-template-columns: 1fr 1fr; }
    }
    .ep-card {
      display: flex;
      flex-direction: column;
      gap: var(--grid);
      height: 100%;
      box-sizing: border-box;
      padding: calc(var(--grid) * 2);
      background: var(--surface);
      border-color: var(--accent);
      box-shadow: 6px 6px 0 var(--accent);
      text-decoration: none;
      color: var(--ink);
    }
    .ep-card:hover {
      background: var(--accent);
      color: var(--bg);
    }
    .ep-card:hover .ep-num,
    .ep-card:hover .ep-years,
    .ep-card:hover .ep-teaser,
    .ep-card:hover .ep-status {
      color: var(--bg);
    }
    .ep-thumb {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 1;
      object-fit: cover;
      border: 2px solid var(--accent);
      margin-bottom: var(--grid);
    }
    .ep-num {
      font-family: var(--font-display);
      font-size: 12px;
      color: var(--accent);
    }
    .ep-title {
      font-family: var(--font-display);
      font-size: 12px;
      line-height: 1.6;
    }
    .ep-years {
      font-family: var(--font-terminal);
      font-size: 20px;
      color: var(--dim);
    }
    .ep-teaser {
      font-size: 14px;
      color: var(--dim);
    }
    .ep-status {
      font-family: var(--font-terminal);
      font-size: 20px;
      margin-top: auto;
    }
    .ep-status.full { color: var(--phosphor); }
    .ep-status.stub { color: var(--amber); }

    .methodology {
      font-family: var(--font-terminal);
      font-size: 20px;
      color: var(--dim);
      margin: calc(var(--grid) * 8) 0 calc(var(--grid) * 4);
      text-align: center;
    }
  </style>
</PageShell>
